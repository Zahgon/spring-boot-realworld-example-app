<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5level --- [%15.15thread] %-40.40logger{39} : %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.spring.infrastructure.mybatis.readservice.ArticleReadService" level="DEBUG"/>
  <logger name="io.spring.infrastructure.mybatis.mapper" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
